% Generated by hand for initial scaffold
\name{sassy_search_connection}
\alias{sassy_search_connection}
\title{Search an R connection with 'sassy'}
\usage{
sassy_search_connection(pattern, con, k, alphabet = c("dna", "iupac", "ascii"),
  rc = TRUE, alpha = NULL, all = FALSE, chunk_size = 1024 * 1024,
  overlap = NULL)
}
\arguments{
\item{pattern}{Raw vector or character scalar containing the query.}
\item{con}{An open readable R connection, preferably opened in binary mode.}
\item{k}{Maximum edit distance.}
\item{alphabet}{Alphabet profile. One of \code{"dna"}, \code{"iupac"}, or \code{"ascii"}.}
\item{rc}{If \code{TRUE}, search reverse-complement strand as well where supported.}
\item{alpha}{Optional IUPAC overhang cost in \code{[0, 1]}. Use \code{NULL} to disable.}
\item{all}{If \code{FALSE}, return local-minimum matches. If \code{TRUE}, return all end positions with score <= \code{k}.}
\item{chunk_size}{Number of new bytes to read per native chunk.}
\item{overlap}{Number of bytes to carry from one chunk to the next. Defaults to \code{pattern_bytes + k} without overhang, and \code{2 * pattern_bytes + k} when \code{alpha} is set.}
}
\value{A data frame of matches with coordinates relative to the full stream.}
\description{Streams bytes from an open R connection through Rsassy's C boundary, avoiding an R-level \code{readBin()} or \code{readChar()} loop while preserving matches across chunk boundaries with an overlap window.}
\examples{
con <- rawConnection(charToRaw("TTACGTAA"), "rb")
on.exit(close(con))
sassy_search_connection("ACGT", con, 0, alphabet = "dna", rc = FALSE, chunk_size = 3)
}
