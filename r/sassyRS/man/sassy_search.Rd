\item{rc}{If \code{TRUE}, search reverse-complement strand as well where supported.}
\item{alpha}{Optional IUPAC overhang cost in \code{[0, 1]}. Use \code{NULL} to disable.}
\item{all}{If \code{FALSE}, return local-minimum matches. If \code{TRUE}, return all end positions with score <= \code{k}.}
}
\value{A data frame of matches.}
\description{Prototype 'extendr' wrapper around the Rust 'sassy' approximate string matcher.}
\examples{
sassy_search("ACGT", "TTACGTAA", 0, alphabet = "dna", rc = FALSE)
