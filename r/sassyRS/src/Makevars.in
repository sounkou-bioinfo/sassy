TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/@LIBDIR@
STATLIB = $(LIBDIR)/libsassyrs.a
PKG_LIBS = -L$(LIBDIR) -lsassyrs

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/vendor
CARGO_FEATURE_ARGS = $(if $(SASSY_RUST_FEATURES),--no-default-features --features $(SASSY_RUST_FEATURES),)

$(STATLIB):
	if [ -n "$(SASSY_RUST_FEATURES)" ]; then echo "=== Using Rust crate features: $(SASSY_RUST_FEATURES) ==="; fi
	if [ -d ./vendor ]; then \
		echo "=== Using offline Rust vendor directory ==="; \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	elif [ -f ./rust/vendor.tar.xz ]; then \
		echo "=== Using offline Rust vendor tarball ==="; \
		tar xf rust/vendor.tar.xz && \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	fi

	export CARGO_HOME=$(CARGOTMP) && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	@PANIC_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ $(CARGO_FEATURE_ARGS) --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) @TARGET@

	export CARGO_HOME=$(CARGOTMP) && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	cargo run @CRAN_FLAGS@ $(CARGO_FEATURE_ARGS) --bin document --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) @TARGET@

	rm -Rf $(CARGOTMP)

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) $(VENDOR_DIR) @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(VENDOR_DIR)
